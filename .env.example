# The workout-agent Edge Function in your Supabase project (no trailing slash)
WORKOUT_AGENT_URL=https://YOUR-REF.supabase.co/functions/v1/workout-agent
# The key you set with: supabase secrets set WORKOUT_AGENT_KEY=...
WORKOUT_AGENT_KEY=
ANTHROPIC_API_KEY=
# Optional: traces and eval datasets in LangSmith (free Developer plan is enough)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=workout-coach
