# The coach's door, served by the six-month-plan app (no trailing slash). Settings → Workout coach →
# "Set up the weekly coach" shows yours, with a Copy button. (The Supabase Edge Function URL works too.)
WORKOUT_AGENT_URL=https://YOUR-APP.vercel.app/api/workout-agent
# The key made in the app: Settings → Workout coach → Make the coach's key
WORKOUT_AGENT_KEY=
ANTHROPIC_API_KEY=
# Optional: traces and eval datasets in LangSmith (free Developer plan is enough)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=workout-coach
# Optional: models by agent (defaults: analyst and critic claude-opus-5-5, planner claude-sonnet-5-5)
# COACH_MODEL_ANALYST=claude-opus-5-5
# COACH_MODEL_PLANNER=claude-sonnet-5-5
# COACH_MODEL_CRITIC=claude-opus-5-5
# COACH_MODEL=            # one model for every agent without its own
